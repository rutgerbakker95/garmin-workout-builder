# Stable public origin, without a trailing slash. Use localhost for local tests.
PUBLIC_BASE_URL=https://your-project.vercel.app
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DOWNLOAD_ENCRYPTION_KEY=
# External OAuth/OIDC provider: RS256 access tokens with this issuer and audience.
OAUTH_ISSUER=https://your-identity-provider.example/
OAUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
OAUTH_AUDIENCE=https://your-project.vercel.app/mcp
# Restrict this personal exporter to your provider's exact user subject (sub).
OAUTH_ALLOWED_SUBJECT=
# Provider must issue this scope for the ChatGPT client.
OAUTH_REQUIRED_SCOPE=workouts:export
